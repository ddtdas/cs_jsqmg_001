# 环境变量模板（.env.example）—— 复制为 .env 后填写（也可直接用环境变量注入）
# 对应主方案 §5.4（知乎合规/频率控制）与 §6.3（LLM 路由与预算）
# 配置前缀统一为 AF_，实现见 app/config.py

# ---- 主控 ----
AF_HOST=127.0.0.1
AF_PORT=9200
AF_DATA_DIR=data

# ---- 认证 ----
# 留空 => 首次启动自动生成 admin key（data/bootstrap_admin_key.txt，af_admin_xxxxxxxx）
# 显式设置 => 作为 bootstrap admin key 覆盖值（MCP 透传层用同一 key 访问本主控）
AF_API_KEY=

# ---- LLM（OpenAI 兼容；DeepSeek 默认，或改本地 Ollama/vLLM）----
# 三者齐备 health 才显示 configured；未配置系统照常启动（D5 降级链）
# AF_LLM_API_KEY 留空 = no_key 降级模式：LLM 调用立即降级为纯规则，不发网络请求
# 连续 3 次调用失败自动熔断到降级链（llm_provider.MAX_FAIL_STREAK）
AF_LLM_BASE_URL=https://api.deepseek.com
AF_LLM_API_KEY=
AF_LLM_MODEL=deepseek-chat
AF_LLM_TIMEOUT=30
AF_LLM_DAILY_BUDGET=0        # 0=不限额；>0=每日次数上限（预算护栏）

# ---- 知乎通道 ----
AF_ZHIHU_RATE_LIMIT=20       # 全局令牌桶：请求/分钟
AF_ZHIHU_ENCRYPT_KEY=        # 留空则首次启动自动生成 data/secret.key（P2 落地）
AF_ZHIHU_KEY_FILE=           # P3-8：Fernet 密钥独立文件路径（可放数据目录外并收紧 ACL/chmod 600）

# ---- 全局请求级限流（P2-5）----
AF_RATE_LIMIT_PER_MIN=60         # 公开热路径（scan/text、accounts/check、traps check-hit）按 IP 令牌桶配额；0=关闭
AF_RATE_LIMIT_ADMIN_BYPASS=true  # 携带有效 admin key 的请求豁免限流
